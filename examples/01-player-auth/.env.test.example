# Copy to .env.test and fill with two synthetic accounts on a disposable PocketBase instance.
# The harness refuses non-local hosts unless PB_TEST_ALLOW_REMOTE=1 is explicitly set.
PB_TEST_URL=http://127.0.0.1:8090
PB_TEST_AUTH_COLLECTION=players
PB_TEST_PROFILE_COLLECTION=player_profiles
PB_TEST_PLAYER_A_EMAIL=
PB_TEST_PLAYER_A_PASSWORD=
PB_TEST_PLAYER_A_ID=
PB_TEST_PROFILE_A_ID=
PB_TEST_PLAYER_B_EMAIL=
PB_TEST_PLAYER_B_PASSWORD=
PB_TEST_PLAYER_B_ID=
PB_TEST_PROFILE_B_ID=
# Only for a disposable remote test instance; never point this at production.
# PB_TEST_ALLOW_REMOTE=1
